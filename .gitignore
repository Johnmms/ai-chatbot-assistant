.vscode/
.idea/
*.swp
*.swo
*~

# 📊 MacOS files
.DS_Store

# 🔍 Pytest cache
.pytest_cache/

# 📦 Distribution files
dist/
build/
*.egg-info/

# 💾 Database files
*.db
*.sqlite
*.sqlite3

# 📝 Log files
*.log
logs/

# 🛠️ OS files
Thumbs.db
